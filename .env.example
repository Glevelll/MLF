# Локальная разработка (SQLite, in-memory вектор, inline-задачи, mock LLM)
MLF_APP_ENV=local
MLF_LLM_PROVIDER=mock            # mock | ollama | hf | openai | anthropic
MLF_LLM_FALLBACK_PROVIDERS=["mock"]
MLF_LLM_MODEL=qwen2.5:7b
MLF_OLLAMA_URL=http://localhost:11434
MLF_TASK_BACKEND=inline          # inline | celery
MLF_VECTOR_BACKEND=memory        # memory | qdrant
MLF_CACHE_BACKEND=db             # db | redis
MLF_JWT_SECRET=local-dev-secret-change-me-in-production-0123456789
# MLF_OPENAI_API_KEY=
# MLF_ANTHROPIC_API_KEY=
# MLF_DATABASE_URL=postgresql+asyncpg://mlf:mlf@localhost:5432/mlf
# Демо-пользователь (scripts/seed_demo_user.py): demo / demo12345 — только локально
